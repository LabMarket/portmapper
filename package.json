{
  "name": "docker-port-mapper",
  "displayName": "Docker Port Mapper",
  "description": "Mapeia portas de containers Docker de um host remoto para a máquina local.",
  "version": "0.1.3",
  "license": "MIT",
  "publisher": "LabMarket",
  "repository": "https://github.com/LabMarket/portmapper.git",
  "bugs": "https://github.com/LabMarket/portmapper/issues",
  "homepage": "https://github.com/LabMarket/portmapper",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:portmapper-hosts-view"
  ],
  "enabledApiProposals": [
    "tunnels"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portmapper-container",
          "title": "Port Mapper",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "portmapper-container": [
        {
          "id": "portmapper-hosts-view",
          "name": "Hosts SSH"
        }
      ]
    },
    "badges": [
      {
        "viewId": "portmapper-hosts-view",
        "type": "number",
        "description": "Número de túneis SSH ativos"
      }
    ],
    "commands": [
      {
        "command": "docker-port-mapper.start",
        "title": "Docker Port Mapper: Iniciar Mapeamento"
      },
      {
        "command": "docker-port-mapper.stop",
        "title": "Docker Port Mapper: Parar Todos os Mapeamentos"
      },
      {
        "command": "docker-port-mapper.editSshConfig",
        "title": "Editar Configuração SSH",
        "icon": "$(gear)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production"
  },
  "dependencies": {
    "get-port": "^5.1.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "node-loader": "^2.1.0",
    "ts-loader": "^9.5.4",
    "vscode-dts": "^0.3.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^5.1.4"
  }
}
